# Copy this file to keystore.properties and fill in the copy.
# keystore.properties is gitignored. Leave the values here empty.
# Do not put a real keystore path, alias, or password in this example.
#
# app/build.gradle does not read keystore.properties. It reads these
# environment variables when they are set:
#   ROOTED_KEYSTORE          path to the .jks or .keystore file
#   ROOTED_STORE_PASSWORD    store password
#   ROOTED_KEY_ALIAS         key alias
#   ROOTED_KEY_PASSWORD      key password
#
# GitHub Actions supplies those four variables from repository secrets
# named ROOTED_KEYSTORE_BASE64, ROOTED_STORE_PASSWORD, ROOTED_KEY_ALIAS,
# and ROOTED_KEY_PASSWORD. See README.md for how to create them.

storeFile=
storePassword=
keyAlias=
keyPassword=
